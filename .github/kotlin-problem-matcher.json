{
  "problemMatcher": [
    {
      "owner": "kotlin-compiler",
      "pattern": [
        {
          "regexp": "^([ew]): (?:file://)?(.+\\.kts?):(\\d+):(\\d+) (.+)$",
          "severity": 1,
          "file": 2,
          "line": 3,
          "column": 4,
          "message": 5
        }
      ]
    }
  ]
}
