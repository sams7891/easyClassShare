{
  "rules": {
    ".read": false,
    ".write": false,
    "joinCodes": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((data.exists() && !newData.exists() && root.child('classes').child(data.child('classId').val()).child('teachers').child(auth.uid).exists()) || (!data.exists() && newData.exists() && (root.child('classes').child(newData.child('classId').val()).child('teachers').child(auth.uid).exists() || (!root.child('classes').child(newData.child('classId').val()).exists() && newData.parent().parent().child('classes').child(newData.child('classId').val()).child('info').child('createdBy').val() === auth.uid))))",
        ".validate": "newData.hasChildren(['classId', 'role']) && newData.child('classId').isString() && (newData.child('role').val() === 'student' || newData.child('role').val() === 'teacher') && $code.matches(/^[A-Z0-9]{6,10}$/)"
      }
    },
    "classSecrets": {
      "$cid": {
        ".read": "auth != null && root.child('classes').child($cid).child('teachers').child(auth.uid).exists()",
        ".write": "auth != null && newData.exists() && (root.child('classes').child($cid).child('teachers').child(auth.uid).exists() || (!data.exists() && !root.child('classes').child($cid).exists() && newData.parent().parent().child('classes').child($cid).child('info').child('createdBy').val() === auth.uid))",
        ".validate": "newData.hasChildren(['studentCode', 'teacherCode']) && newData.child('studentCode').isString() && newData.child('teacherCode').isString()"
      }
    },
    "classes": {
      "$cid": {
        "info": {
          ".read": "auth != null && (root.child('classes').child($cid).child('teachers').child(auth.uid).exists() || root.child('classes').child($cid).child('devices').child(auth.uid).exists())",
          ".write": "auth != null && newData.exists() && ((!data.exists() && newData.child('createdBy').val() === auth.uid) || root.child('classes').child($cid).child('teachers').child(auth.uid).exists())",
          ".validate": "newData.hasChildren(['name', 'createdBy']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 40"
        },
        "teachers": {
          ".read": "auth != null && root.child('classes').child($cid).child('teachers').child(auth.uid).exists()",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && ((auth.uid === $uid && !data.exists() && newData.exists() && (newData.child('code').val() === root.child('classSecrets').child($cid).child('teacherCode').val() || (!root.child('classes').child($cid).child('info').exists() && newData.parent().parent().child('info').child('createdBy').val() === auth.uid))) || (!newData.exists() && root.child('classes').child($cid).child('teachers').child(auth.uid).exists()))",
            ".validate": "newData.hasChildren(['name', 'code', 'joinedAt']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 40"
          }
        },
        "devices": {
          ".read": "auth != null && root.child('classes').child($cid).child('teachers').child(auth.uid).exists()",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && ((auth.uid === $uid && !data.exists() && newData.exists() && newData.child('code').val() === root.child('classSecrets').child($cid).child('studentCode').val()) || (!newData.exists() && (auth.uid === $uid || root.child('classes').child($cid).child('teachers').child(auth.uid).exists())))",
            ".validate": "newData.hasChildren(['name', 'code', 'joinedAt']) && newData.child('name').isString() && newData.child('name').val().length > 0 && newData.child('name').val().length <= 40",
            "name": {
              ".write": "auth != null && data.parent().exists() && newData.exists() && root.child('classes').child($cid).child('teachers').child(auth.uid).exists()",
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
            },
            "code": {
              ".validate": "newData.isString()"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "online": {
              ".write": "auth != null && auth.uid === $uid && data.parent().exists()",
              ".validate": "newData.isBoolean()"
            },
            "lastSeen": {
              ".write": "auth != null && auth.uid === $uid && data.parent().exists()",
              ".validate": "newData.isNumber()"
            },
            "battery": {
              ".write": "auth != null && auth.uid === $uid && data.parent().exists()",
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "charging": {
              ".write": "auth != null && auth.uid === $uid && data.parent().exists()",
              ".validate": "newData.isBoolean()"
            },
            "canLock": {
              ".write": "auth != null && auth.uid === $uid && data.parent().exists()",
              ".validate": "newData.isBoolean()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "sound": {
          ".read": "auth != null && root.child('classes').child($cid).child('teachers').child(auth.uid).exists()",
          ".write": "auth != null && root.child('classes').child($cid).child('teachers').child(auth.uid).exists()",
          "all": {
            ".read": "auth != null && (root.child('classes').child($cid).child('teachers').child(auth.uid).exists() || root.child('classes').child($cid).child('devices').child(auth.uid).exists())",
            ".validate": "newData.isBoolean()"
          },
          "devices": {
            "$uid": {
              ".read": "auth != null && auth.uid === $uid",
              ".validate": "newData.isBoolean()"
            }
          },
          "until": {
            ".read": "auth != null && (root.child('classes').child($cid).child('teachers').child(auth.uid).exists() || root.child('classes').child($cid).child('devices').child(auth.uid).exists())",
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "messages": {
          ".read": "auth != null && (root.child('classes').child($cid).child('teachers').child(auth.uid).exists() || root.child('classes').child($cid).child('devices').child(auth.uid).exists())",
          "$mid": {
            ".write": "auth != null && root.child('classes').child($cid).child('teachers').child(auth.uid).exists() && (!data.exists() || !newData.exists())",
            ".validate": "newData.hasChildren(['from', 'content', 'ts', 'by']) && newData.child('content').isString() && newData.child('content').val().length > 0 && newData.child('content').val().length <= 2000 && newData.child('from').isString() && newData.child('from').val().length <= 40 && newData.child('ts').isNumber() && newData.child('by').val() === auth.uid"
          }
        },
        "inbox": {
          ".read": "auth != null && root.child('classes').child($cid).child('teachers').child(auth.uid).exists()",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid && root.child('classes').child($cid).child('devices').child($uid).exists()",
            ".write": "auth != null && !newData.exists() && root.child('classes').child($cid).child('teachers').child(auth.uid).exists()",
            "$mid": {
              ".write": "auth != null && root.child('classes').child($cid).child('teachers').child(auth.uid).exists() && (!data.exists() || !newData.exists())",
              ".validate": "newData.hasChildren(['from', 'content', 'ts', 'by']) && newData.child('content').isString() && newData.child('content').val().length > 0 && newData.child('content').val().length <= 2000 && newData.child('from').isString() && newData.child('from').val().length <= 40 && newData.child('ts').isNumber() && newData.child('by').val() === auth.uid && root.child('classes').child($cid).child('devices').child($uid).exists()"
            }
          }
        },
        "opened": {
          ".read": "auth != null && root.child('classes').child($cid).child('teachers').child(auth.uid).exists()",
          "$mid": {
            ".write": "auth != null && !newData.exists() && root.child('classes').child($cid).child('teachers').child(auth.uid).exists()",
            "$uid": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && newData.exists() && root.child('classes').child($cid).child('devices').child($uid).exists() && (root.child('classes').child($cid).child('messages').child($mid).exists() || root.child('classes').child($cid).child('inbox').child($uid).child($mid).exists())",
              ".validate": "newData.isNumber()"
            }
          }
        },
        "attention": {
          ".read": "auth != null && (root.child('classes').child($cid).child('teachers').child(auth.uid).exists() || root.child('classes').child($cid).child('devices').child(auth.uid).exists())",
          ".write": "auth != null && root.child('classes').child($cid).child('teachers').child(auth.uid).exists()",
          ".validate": "newData.hasChildren(['text', 'from', 'ts']) && newData.child('text').isString() && newData.child('text').val().length > 0 && newData.child('text').val().length <= 100 && newData.child('from').isString() && newData.child('from').val().length <= 40 && newData.child('ts').isNumber()"
        }
      }
    }
  }
}
